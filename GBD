<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:Segoe UI,Arial,sans-serif;
  background:#ffffff;
  color:#222;
  display:flex;
  align-items:center;
  justify-content:center;
  height:100vh;
  transition:opacity 1.5s ease;
}
body.hidden{
  opacity:0;
  pointer-events:none;
  background:transparent;
}
.w{display:flex;flex-direction:column;align-items:center;gap:18px}
.logos{display:flex;align-items:center;justify-content:center;gap:30px;flex-wrap:wrap}
.logo-miambiente{height:50px;max-width:220px;object-fit:contain}
.logo-gbd{height:55px;object-fit:contain}
.c{display:flex;gap:12px;align-items:center}
.b{
  background:#f5f5f5;
  border:1px solid #ddd;
  border-radius:12px;
  padding:14px 18px;
  min-width:75px;
  text-align:center;
  box-shadow:0 3px 8px rgba(0,0,0,0.08)
}
.v{font-size:2.3rem;font-weight:700;color:#b8860b;line-height:1}
.l{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:#666;margin-top:6px}
.s{font-size:1.8rem;color:#bbb;padding-bottom:12px}
</style>
</head>
<body>
<div class="w">
  <div class="logos">
    <img class="logo-miambiente"
    src="https://images.weserv.nl/?url=geoportal.miambiente.gob.pa/portal/sharing/rest/content/items/57b3d89cf61d4b2688fdce1f7f54ed67/data"
    alt="MiAmbiente">
    <img class="logo-gbd"
    src="https://images.weserv.nl/?url=globalbigdaypanama.com/wp-content/uploads/2025/04/rsw_2320h_928-e1772071756653-2048x567.webp"
    alt="Global Big Day Panamá">
  </div>
  <div class="c">
    <div class="b"><div class="v" id="d">00</div><div class="l">Días</div></div>
    <span class="s">:</span>
    <div class="b"><div class="v" id="h">00</div><div class="l">Hrs</div></div>
    <span class="s">:</span>
    <div class="b"><div class="v" id="m">00</div><div class="l">Min</div></div>
    <span class="s">:</span>
    <div class="b"><div class="v" id="s">--</div><div class="l">Seg</div></div>
  </div>
</div>
<script>
var TARGET=Date.now()+10000,
    timer,
    p=function(n){return("0"+n).slice(-2)};
function u(){
  var r=TARGET-Date.now();
  if(r<=0){
    document.body.classList.add("hidden");
    clearInterval(timer);
    return;
  }
  d.textContent=p(Math.floor(r/864e5));
  h.textContent=p(Math.floor(r%864e5/36e5));
  m.textContent=p(Math.floor(r%36e5/6e4));
  s.textContent=p(Math.floor(r%6e4/1e3));
}
u();
timer=setInterval(u,1000);
</script>
</body>
</html>
